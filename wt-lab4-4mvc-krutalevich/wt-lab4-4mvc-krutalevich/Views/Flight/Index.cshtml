@model List<wt_lab4_4mvc_krutalevich.Models.Flight>

@{
    ViewData["Title"] = "Рейсы";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог рейсов</h1>
            <p class="text-muted mb-0">Авиакомпания — система бронирования билетов</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            + Добавить рейс
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Рейсов пока нет. Добавьте первый рейс.
        </div>
    }
    else
    {
        <p class="text-muted">Всего рейсов: @Model.Count</p>

        <div class="row g-4">
            @foreach (var flight in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-secondary">
                                    ID: @flight.Id
                                </span>
                                @if (flight.IsAvailable)
                                {
                                    <span class="badge bg-success">Доступен</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Нет мест</span>
                                }
                            </div>

                            <h5 class="card-title fw-bold mb-1">
                                @flight.FlightNumber
                            </h5>
                            <p class="text-muted mb-3">
                                @flight.Departure → @flight.Arrival
                            </p>

                            <p class="fs-4 fw-bold text-primary mb-3">
                                @flight.Price.ToString("F2") руб.
                            </p>

                            <div class="d-flex gap-2 mt-auto">
                                <a asp-action="Details"
                                   asp-route-id="@flight.Id"
                                   class="btn btn-outline-primary btn-sm flex-grow-1">
                                    Подробнее
                                </a>
                                <a asp-action="Edit"
                                   asp-route-id="@flight.Id"
                                   class="btn btn-outline-warning btn-sm">✎</a>
                                <a asp-action="Delete"
                                   asp-route-id="@flight.Id"
                                   class="btn btn-outline-danger btn-sm">✕</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>