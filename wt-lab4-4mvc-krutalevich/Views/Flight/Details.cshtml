@model wt_lab4_4mvc_krutalevich.Models.Flight

@{
    ViewData["Title"] = "Рейс " + Model.FlightNumber;
}

<div class="container py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">Рейсы</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                @Model.FlightNumber
            </li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow rounded-4">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0 fs-4">Рейс @Model.FlightNumber</h2>
                </div>
                <div class="card-body">

                    <dl class="row mb-0">
                        <dt class="col-sm-5">ID</dt>
                        <dd class="col-sm-7">@Model.Id</dd>

                        <dt class="col-sm-5">Номер рейса</dt>
                        <dd class="col-sm-7">@Model.FlightNumber</dd>

                        <dt class="col-sm-5">Город вылета</dt>
                        <dd class="col-sm-7">@Model.Departure</dd>

                        <dt class="col-sm-5">Город прилёта</dt>
                        <dd class="col-sm-7">@Model.Arrival</dd>

                        <dt class="col-sm-5">Цена</dt>
                        <dd class="col-sm-7">
                            <span class="fs-4 fw-bold text-primary">
                                @Model.Price.ToString("F2") руб.
                            </span>
                        </dd>

                        <dt class="col-sm-5">Доступен</dt>
                        <dd class="col-sm-7">
                            @if (Model.IsAvailable)
                            {
                                <span class="badge bg-success">Да</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Нет</span>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-white d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        ← Назад к списку
                    </a>
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-primary">
                        Редактировать
                    </a>
                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-danger">
                        Удалить
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>